# Database
DATABASE_URL=postgresql+asyncpg://podking:podking@localhost:5432/podking

# Session
SESSION_SECRET_KEY=change-me-at-least-32-random-bytes

# Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-real-one

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# App
APP_BASE_URL=http://localhost:8000
ALLOWED_EMAILS=you@example.com
MAX_DURATION_SECONDS=14400
AUDIO_STORAGE_PATH=./data/audio
LOG_LEVEL=INFO

# Listen Notes — for podcast search and Apple URL resolution.
# Get a key at https://www.listennotes.com/api/. Free tier supports search,
# metadata, and audio URLs but not RSS feed URLs (PRO/ENTERPRISE only).
LISTEN_NOTES_API_KEY=

# yt-dlp cookies (Netscape format). Required when YouTube blocks the server
# with "Sign in to confirm you're not a bot" — common on cloud IPs. Export
# with a browser extension like "Get cookies.txt LOCALLY" while logged into
# youtube.com. Two ways to provide them — set ONE:
#   YT_DLP_COOKIES_FILE: path to a mounted cookies.txt (preferred locally)
#   YT_DLP_COOKIES:      raw file contents as a multi-line env var (PaaS)
# If both are set, YT_DLP_COOKIES_FILE wins.
# See https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
YT_DLP_COOKIES_FILE=
YT_DLP_COOKIES=

# URL of a bgutil-ytdlp-pot-provider HTTP server. On datacenter IPs (Railway,
# AWS, GCP) YouTube rejects requests despite valid cookies — a Proof of
# Origin token from this provider unblocks them. Deploy as a sidecar:
#   Railway: add a new service from brainicism/bgutil-ytdlp-pot-provider,
#            then set this to http://<service>.railway.internal:4416
# Leave blank if not using a provider (fine on residential IPs).
YT_DLP_POT_PROVIDER_URL=

# ── Audio podcast feature ────────────────────────────────────────────────
# Default ElevenLabs voice IDs (overridden per-user in Settings).
ELEVENLABS_TTS_DEFAULT_VOICE_A=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_DEFAULT_VOICE_B=AZnzlk1XvdvUeBnXmlld
ELEVENLABS_TTS_MODEL_ID=eleven_turbo_v2_5

# Personal podcast feed — leave blank to disable the feature.
# A fine-grained GitHub PAT scoped to GITHUB_AUDIO_REPO with
# Contents: read/write and Pages: write. The server clones, commits,
# pushes via this token; users never see GitHub.
GITHUB_PAT=
GITHUB_AUDIO_REPO=
GITHUB_AUDIO_BASE_URL=
PODKING_FEED_OWNER_EMAIL=
